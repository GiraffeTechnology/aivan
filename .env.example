# Production must select a reviewed auth profile and bind every key to a tenant.
# Local mode may run unauthenticated.
AIVAN_ENV=local
AIVAN_API_KEY=
AIVAN_TENANT_ID=
AIVAN_TENANT_API_KEYS={}
AIVAN_HOST=127.0.0.1
AIVAN_PORT=8765
AIVAN_DB_URL=sqlite:///./data/aivan.db
AIVAN_REQUIRE_HUMAN_APPROVAL=true
# Comma-separated exact browser origins. Production defaults to no cross-origin
# browser access; '*' is rejected. Localhost defaults apply only in local mode.
AIVAN_CORS_ORIGINS=

OPENCLAW_BASE_URL=
OPENCLAW_API_KEY=
OPENCLAW_SEND_ENDPOINT=/messages/send
OPENCLAW_MOCK_MODE=true
OPENCLAW_MARKETPLACE_ENABLED=true
OPENCLAW_MARKETPLACE_SEARCH_ENDPOINT=/marketplaces/search

# ── Controlled real-test email gateway ───────────────────────────────────────
# Disabled by default. Enable only for an approved OpenClaw real-test run.
# 163 requires a client authorization code here, not the web login password.
AIVAN_EMAIL_SEND_MODE=
AIVAN_EMAIL_GATEWAY=
AIVAN_EMAIL_ALLOWED_RECIPIENTS=
AIVAN_PRESET_MAILBOX=giraffetechnology@163.com
AIVAN_SMTP_HOST=smtp.163.com
AIVAN_SMTP_PORT=465
AIVAN_SMTP_USE_SSL=true
AIVAN_SMTP_USE_TLS=false
AIVAN_SMTP_USERNAME=giraffetechnology@163.com
AIVAN_SMTP_PASSWORD=
AIVAN_POP3_HOST=pop.163.com
AIVAN_POP3_PORT=995
AIVAN_POP3_USE_SSL=true
AIVAN_POP3_USERNAME=giraffetechnology@163.com
AIVAN_POP3_PASSWORD=

# ── Private-domain model policy ──────────────────────────────────────────────
# The private-domain RFQ baseline must close without any EXTERNAL provider API.
# External provider APIs (OpenAI/Anthropic/Gemini/DashScope/Qwen cloud) are a
# controlled escalation requiring an explicit approval packet — never automatic.
# Private-domain LOCAL LLM endpoints (Ollama serving qwen3.5:2b) are allowed.
# ENABLED only means the external connector may be built; every external call
# still requires an explicit ExternalModelApproval. AUTO_ALLOWED (default false,
# never true in private-domain baseline) is the only way to skip per-call approval.
AIVAN_EXTERNAL_MODEL_API_ENABLED=false
AIVAN_EXTERNAL_MODEL_API_AUTO_ALLOWED=false
AIVAN_LLM_API_ENABLED=true
AIVAN_VLM_API_ENABLED=false
AIVAN_VLM_PROVIDER=disabled
# Stub/demo suppliers must never be used in production; enable only for demos.
AIVAN_ALLOW_STUB_SUPPLIERS=false
# GLTG may use a private-domain local LLM (traced, bounded); never external.
GLTG_LOCAL_LLM_ENABLED=false

AIVAN_LLM_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:2b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GOOGLE_API_KEY=
GEMINI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=
AIVAN_LLM_TIMEOUT_SECONDS=30
AIVAN_LLM_MAX_RETRIES=2
AIVAN_LLM_TEMPERATURE=0

# ── Local-LLM Token Guard (production stability, P0) ─────────────────────────
# Code-level protection for the single-CPU Ollama box: every local request is
# streamed with a forced output cap, a wall-clock circuit-break, real
# cancellation, and a single-slot concurrency gate. Safe defaults; only set to
# override. Never put a real host here — the endpoint comes from OLLAMA_BASE_URL.
LLM_GUARD_ENABLED=true                # explicit opt-out only; on by default
LLM_HARD_MAX_NUM_PREDICT=2048         # absolute output cap; no call may exceed
LLM_DEFAULT_NUM_PREDICT=512           # default budget when unspecified
LLM_THINK_DEFAULT=false               # thinking mode off unless a reasoning profile
LLM_THINK_NUM_PREDICT=1024            # budget for think=true profiles
LLM_CONTEXT_WINDOW=4096               # must match Ollama's running context
LLM_MAX_PROMPT_TOKENS_RATIO=0.75      # est_prompt <= window*ratio, and est+out <= window
LLM_CONCURRENCY=1                     # app-level gate; mirror OLLAMA_NUM_PARALLEL. Do NOT raise on 4C16G.
LLM_QUEUE_WAIT_TIMEOUT_S=100          # queue wait before failing fast (LlmBusyError); ~one inference so a 2nd request queues, a 3rd+ fails fast
LLM_LOAD_TIME_BUFFER_S=15             # cold-load buffer in the timeout formula
LLM_GEN_SPEED_TPS=5.0                 # conservative generation speed (tokens/s)
LLM_PROMPT_SPEED_TPS=15.0             # conservative prompt-processing speed (tokens/s)
LLM_TIMEOUT_SAFETY_FACTOR=1.5         # multiplier on the computed timeout
# Effective per-inference timeout = min(formula, per-profile ceiling, absolute backstop).
# Per-profile ceilings let interactive replies stay snappy while reasoning
# profiles actually get enough wall-clock to complete their token budget on a
# ~5 tok/s CPU box (256 tok~=51s, 512~=102s, 1024~=205s, 2048~=410s).
LLM_QA_MAX_TIMEOUT_S=90               # qa_short / qa_standard ceiling (interactive)
LLM_REASONING_TIMEOUT_S=240          # reasoning ceiling (num_predict=1024)
LLM_REASONING_MAX_TIMEOUT_S=480      # reasoning_max ceiling (num_predict=2048)
LLM_MAX_INFERENCE_TIMEOUT_S=480      # ABSOLUTE backstop: no single inference may ever exceed this (force-abort)

AIVAN_ALIBABA_MODE=mock

AIVAN_WEB_SEARCH_PROVIDER=mock
OPENCLAW_SEARCH_ENDPOINT=/search/web

AIVAN_ENABLE_UNKNOWN_SUPPLIER_RISK_SEARCH=true
AIVAN_BLOCK_CRITICAL_RISK_SUPPLIERS=false

AIVAN_DEFAULT_MARGIN_RATE=0.15
AIVAN_HIDE_SUPPLIER_IDENTITY_FROM_BUYER=true
AIVAN_HIDE_SUPPLIER_PRICE_FROM_BUYER=true

# ── GPM / giraffe-db ─────────────────────────────────────────────────────────
# giraffe-db base URL (local: empty permits memory mode; production: required and
# unavailable/empty fails GPM closed)
GIRAFFE_DB_BASE_URL=

# GPM LLM runtime mode: mock | live (uses AIVAN_LLM_PROVIDER when live)
GPM_LLM_RUNTIME_MODE=mock

# ── Auth ─────────────────────────────────────────────────────────────────────
# HMAC secret for generating and verifying Bearer tokens
# Optional HMAC profile. X-Tenant-ID dev fallback is local-only and is never
# accepted as production authentication.
AIVAN_AUTH_SECRET=

# ── myAIVAN UI sessions ─────────────────────────────────────────────────────
AIVAN_UI_SESSION_SECRET=
AIVAN_UI_ACTOR_ID=
AIVAN_UI_ALLOWED_ROLES=admin
AIVAN_UI_DEFAULT_ROLE=admin
# Optional isolated test account. Keep disabled unless every value is supplied
# in the protected runtime. The ticket-signing secret must contain at least 32
# characters, and the test tenant must differ from AIVAN_TENANT_ID. Login links
# use short-lived, single-use tickets minted by trusted server-side tooling.
AIVAN_UI_TEST_ACCOUNT_ENABLED=false
AIVAN_UI_TEST_TICKET_SECRET=
# Absolute, private SQLite path shared by every application worker. Its parent
# must already exist with owner-only permissions (0700); the ledger is 0600.
AIVAN_UI_TEST_TICKET_LEDGER_PATH=
AIVAN_UI_TEST_SESSION_TTL_SECONDS=1800
AIVAN_UI_TEST_TENANT_ID=myaivan_ui_test
AIVAN_UI_TEST_ACTOR_ID=myaivan-ui-test
AIVAN_UI_TEST_ALLOWED_ROLES=auditor
AIVAN_UI_TEST_DEFAULT_ROLE=auditor

# Shared secret for AIVAN → giraffe-db service-to-service auth (X-Service-Auth header).
# Must match GIRAFFE_DB_SERVICE_AUTH_SECRET on the giraffe-db side. Leave empty for dev mode.
GIRAFFE_DB_SERVICE_AUTH_SECRET=

# Standalone GLTG service
GLTG_API_BASE_URL=http://localhost:8090
GLTG_API_TIMEOUT_SECONDS=30

# ── Giraffe Language Skill Layer ─────────────────────────────────────────────
# Shared multilingual canonicalization + deterministic extraction service.
# Used for RFQ intake canonicalization (normalize -> structure/rfq) so explicit
# business facts are never lost to a small local LLM. Fail-soft by default.
AIVAN_LANGUAGE_SKILL_ENABLED=true
AIVAN_LANGUAGE_SKILL_BASE_URL=http://127.0.0.1:8788
AIVAN_LANGUAGE_SKILL_TIMEOUT_SECONDS=10
AIVAN_LANGUAGE_SKILL_FAIL_SOFT=true
