# AIVAN production environment (CTYUN private-domain, CPU-only).
# Reference schema only. Do not copy to a host or activate it without a specific
# Stage 7F authorization. Secrets and environment-specific endpoints are injected
# by the authorized secret/configuration store; do NOT commit the real file.
#
# Model decision:
# The currently reported AIVAN host model is qwen3.5:9b. The authorized Stage 7F
# preflight must verify the exact installed model; this template must not pull,
# remove, replace, or silently downgrade a model.
# External LLM/VLM APIs are OFF and require explicit approval.

AIVAN_ENV=production
# Recommended single-deployment profile: set AIVAN_API_KEY and bind it to exactly
# one AIVAN_TENANT_ID. For multi-tenant keys, use AIVAN_TENANT_API_KEYS instead.
# HMAC GPM is an alternate profile; do not mix profiles without a reviewed plan.
AIVAN_API_KEY=
AIVAN_AUTH_SECRET=
AIVAN_TENANT_ID=
AIVAN_TENANT_API_KEYS={}
AIVAN_CORS_ORIGINS=
AIVAN_HOST=127.0.0.1
AIVAN_PORT=8765
# REQUIRED in production. Inject the authorized MySQL/SQLAlchemy URL; blank
# fails startup. No credential, host, or port belongs in this repository.
AIVAN_DB_URL=
AIVAN_LOG_LEVEL=INFO
AIVAN_REQUIRE_HUMAN_APPROVAL=true

# ── Private-domain local model (production) ──────────────────────────────────
AIVAN_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
AIVAN_LLM_API_ENABLED=true

# ── Local-LLM Token Guard (single 4C16G CPU box; P0 stability) ───────────────
# Forces a bounded, streamed, cancellable, single-slot call to Ollama so one
# runaway request can never pin the production CPU. LLM_MAX_INFERENCE_TIMEOUT_S
# is the hard circuit-break: any single inference is aborted at 60s.
LLM_GUARD_ENABLED=true
LLM_HARD_MAX_NUM_PREDICT=2048
LLM_DEFAULT_NUM_PREDICT=512
LLM_THINK_DEFAULT=false
LLM_THINK_NUM_PREDICT=1024
LLM_CONTEXT_WINDOW=4096
LLM_MAX_PROMPT_TOKENS_RATIO=0.75
LLM_CONCURRENCY=1
LLM_QUEUE_WAIT_TIMEOUT_S=100
LLM_LOAD_TIME_BUFFER_S=15
LLM_GEN_SPEED_TPS=5.0
LLM_PROMPT_SPEED_TPS=15.0
LLM_TIMEOUT_SAFETY_FACTOR=1.5
# Effective per-inference timeout = min(formula, per-profile ceiling, absolute backstop).
LLM_QA_MAX_TIMEOUT_S=90
LLM_REASONING_TIMEOUT_S=240
LLM_REASONING_MAX_TIMEOUT_S=480
LLM_MAX_INFERENCE_TIMEOUT_S=480

# ── External model policy: OFF, approval-gated ───────────────────────────────
AIVAN_EXTERNAL_MODEL_API_ENABLED=false
AIVAN_EXTERNAL_MODEL_API_AUTO_ALLOWED=false
AIVAN_VLM_API_ENABLED=false
AIVAN_VLM_PROVIDER=disabled

# ── Supplier boundary: no fabricated suppliers in production ──────────────────
AIVAN_ALLOW_STUB_SUPPLIERS=false

# ── GLTG (lead-time authority) ───────────────────────────────────────────────
GLTG_API_BASE_URL=http://127.0.0.1:8090
GLTG_API_TIMEOUT_SECONDS=30
GLTG_LOCAL_LLM_ENABLED=true
GLTG_LLM_PROVIDER=ollama
GLTG_LLM_MODEL=qwen3.5:9b

# ── Language skill (canonicalization; fail-soft) ─────────────────────────────
AIVAN_LANGUAGE_SKILL_ENABLED=true
AIVAN_LANGUAGE_SKILL_BASE_URL=http://127.0.0.1:8788
AIVAN_LANGUAGE_SKILL_TIMEOUT_SECONDS=10
AIVAN_LANGUAGE_SKILL_FAIL_SOFT=true

# ── OpenClaw (real gateway in production; never mock) ─────────────────────────
OPENCLAW_MOCK_MODE=false
OPENCLAW_BASE_URL=
OPENCLAW_API_KEY=

# ── giraffe-db / GPM ─────────────────────────────────────────────────────────
# REQUIRED for production GPM. Blank/unavailable causes GPM to fail closed; it
# never falls back to restart-unsafe memory persistence in production.
GIRAFFE_DB_BASE_URL=
GIRAFFE_DB_SERVICE_AUTH_SECRET=
GPM_LLM_RUNTIME_MODE=live
